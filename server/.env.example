# Server
PORT=3001
NODE_ENV=development

# MongoDB (Atlas or local) — no real credentials, provide your own
# Local:     mongodb://localhost:27017/vamshi
# Atlas:     mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vamshi?retryWrites=true&w=majority
MONGODB_URI=
# Database name used when MONGODB_URI omits one (defaults to "vamshi").
# Not needed if the URI already contains a database segment.
MONGODB_DB=vamshi

# Auth — REQUIRED in production. Use long random values (e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=365d

# Cookies
# COOKIE_SECURE must be "true" in production (HTTPS). Defaults to true in production.
# COOKIE_SAME_SITE: "lax" (default) when the frontend is served from the SAME origin as
# the API (recommended — the server serves client/dist in production). Use "none" when
# the frontend is hosted on a DIFFERENT origin/site (e.g. Vercel frontend + Render API).
# COOKIE_PARTITIONED="true" is required for "none" when the API host and the frontend host
# are on different sites (e.g. *.onrender.com subdomains are cross-site because onrender.com
# is a public suffix). Partitioned keeps login working under browser third-party-cookie
# blocking. Only needed for cross-site; not needed (harmless) for same-origin.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_PARTITIONED=false

# CORS — comma-separated list of allowed frontend origins (no wildcard with credentials)
# Example: CLIENT_ORIGIN=https://vamshi.example.com
CLIENT_ORIGIN=http://localhost:5173

# Bootstrap account (created on first run when no user exists) — replace before public use
BOOTSTRAP_NAME=Me
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

# Uploads
MAX_RECEIPT_SIZE_MB=5

# Razorpay payments — OPTIONAL. The app starts fine without these; the
# subscription page will show that payments are not configured. Never expose
# RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET to the frontend.
# Get keys from the Razorpay dashboard (Test Mode for development).
# PAYMENT_MODE: "test" (dev default) or "live". Production FORCES live — the app
# refuses to run production with test payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_MODE=test
# Optional: reuse a specific Razorpay plan id for renewals (else auto-created).
# Number of paid billing cycles for the auto-renew subscription (36 = 3 years).
RAZORPAY_PLAN_ID=
RAZORPAY_SUBSCRIPTION_CYCLES=36

# Web Push (VAPID) — optional, leave empty to disable device push.
# Generate keys with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is a contact URI (mailto:) used when registering with push
# services. NEVER commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto: