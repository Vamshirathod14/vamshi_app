# Google AdSense (free app monetisation).
# Copy this file to client/.env and fill in your REAL values, then rebuild the
# client. Until VITE_ADSENSE_CLIENT is set, no ad scripts are loaded at all.
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# Ad unit slot ids come from AdSense > Ads > Display ads ('data-ad-slot').
# They are referenced as props in screens/Dashboard.jsx and screens/More.jsx.