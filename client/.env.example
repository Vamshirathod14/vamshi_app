# API base URL for the production backend.
# - Leave EMPTY when the frontend is served by the same origin as the backend
#   (recommended single-container deployment) — requests use relative /api paths.
# - Set to the backend origin (e.g. https://vamshi-api.example.com) when the
#   frontend is hosted on a different domain. Requests will include credentials,
#   so CORS + COOKIE_SAME_SITE=none must be configured accordingly.
#
# Example:
# VITE_API_URL=https://vamshi-api.example.com
#
VITE_API_URL=