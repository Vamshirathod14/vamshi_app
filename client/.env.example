# Google AdSense (free app monetisation).
# The publisher ID below is ALSO baked into client/src/components/AdBanner.jsx
# and client/index.html, so ads work even without a local .env. Override it
# here (or via a VITE_ build env on Render) if you ever change publishers.
VITE_ADSENSE_CLIENT=ca-pub-5290892277325184
# Ad unit slot ids come from AdSense > Ads > Display ads ('data-ad-slot').
# Replace the PLACEHOLDER slot ids before going live — they are passed as
# props in screens/Dashboard.jsx (1234567890) and screens/More.jsx (0987654321).
# Example:
# VITE_ADSENSE_SLOT_DASHBOARD=1234567890
# VITE_ADSENSE_SLOT_MORE=0987654321